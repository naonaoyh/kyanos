# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.o
# Allow pre-built protoc-gen plugins (needed for make generate-proto)
!.protogen_bin/*.exe
__debug**
node_modules/
docs/.vitepress/dist
docs/.vitepress/cache

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# asciinema files
*.cast

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
.vscode/
.idea/
.output/
deps/**

eapm-ebpf
kyanos

dist/

# Debug/diagnostic artifacts
.diag_backup/
.serena/
.spec-workflow/
.tmp/
*.log
check_version.sh
diag_bpf.sh
diag_test.sh
run_smoke_test.sh
tmp_script.sh

# Removed test scripts (superseded or redundant)
run_quick_test.sh
test_build.sh
test_capture.sh
test_http_ntrip_caster.py
test_ntrip_capture.sh
test_ntrip_tui.sh
test_ntrip_webui.sh
bpf/btfgen.sh

# Developer debugging scripts (agent/testdata/)
agent/testdata/bpftrace_*.sh
agent/testdata/bpftool_*.sh
agent/testdata/check_cpu.sh
